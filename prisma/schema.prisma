generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id             String    @id @default(cuid())
  musicBrainzId  String    @unique @db.Uuid
  name           String
  sortName       String?
  disambiguation String?
  countryCode    String?   @db.VarChar(2)
  beginDate      String?
  endDate        String?
  lastSyncedAt   DateTime?
  artworkLastSearchedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  albums   Album[]              @relation("PrimaryArtistAlbums")
  favorites Favorite[]
  collectionItems CollectionItem[]
  genres   ArtistGenre[]
  outgoing ArtistRelationship[] @relation("SourceArtist")
  incoming ArtistRelationship[] @relation("TargetArtist")
  artworkAssets ArtworkAsset[]

  @@index([name])
  @@index([sortName])
  @@map("artists")
}

model Album {
  id                        String    @id @default(cuid())
  musicBrainzReleaseGroupId String    @unique @db.Uuid
  title                     String
  firstReleaseDate          String?
  albumType                 String?
  artworkLastSearchedAt     DateTime?
  primaryArtistId           String
  primaryArtist             Artist    @relation("PrimaryArtistAlbums", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  lastSyncedAt              DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  genres AlbumGenre[]
  favorites Favorite[]
  collectionItems CollectionItem[]
  artworkAssets ArtworkAsset[]

  @@index([title])
  @@index([primaryArtistId])
  @@index([primaryArtistId, firstReleaseDate])
  @@map("albums")
}

model Genre {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artists ArtistGenre[]
  albums  AlbumGenre[]

  @@index([name])
  @@map("genres")
}

model ArtistGenre {
  artistId String
  genreId  String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
  @@map("artist_genres")
}

model AlbumGenre {
  albumId String
  genreId String

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([albumId, genreId])
  @@index([genreId])
  @@map("album_genres")
}

model ArtistRelationship {
  id                     String   @id @default(cuid())
  sourceArtistId         String
  targetArtistId         String
  relationshipType       String
  sourceProvider         String
  externalRelationshipId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sourceArtist Artist @relation("SourceArtist", fields: [sourceArtistId], references: [id], onDelete: Cascade)
  targetArtist Artist @relation("TargetArtist", fields: [targetArtistId], references: [id], onDelete: Cascade)

  @@unique([sourceArtistId, targetArtistId, relationshipType, sourceProvider])
  @@index([targetArtistId, relationshipType])
  @@index([sourceArtistId, relationshipType])
  @@map("artist_relationships")
}


enum ArtworkSourceProvider {
  WIKIMEDIA_COMMONS
  COVER_ART_ARCHIVE
  THE_AUDIO_DB
}

enum ArtworkReviewStatus {
  PENDING
  AUTO_APPROVED
  CLEARED
  REJECTED
}

model ArtworkAsset {
  id                String               @id @default(cuid())
  artistId          String?
  albumId           String?
  sourceProvider    ArtworkSourceProvider
  sourceFileId      String
  sourcePageUrl     String
  imageUrl          String
  description       String?
  creator           String?
  credit            String?
  licenseShortName  String?
  licenseUrl        String?
  width             Int?
  height            Int?
  relevanceScore    Int?
  selectionReason   String?
  reviewStatus      ArtworkReviewStatus  @default(PENDING)
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  artist Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([artistId, sourceProvider, sourceFileId])
  @@unique([albumId, sourceProvider, sourceFileId])
  @@index([artistId, reviewStatus, updatedAt])
  @@index([albumId, reviewStatus, updatedAt])
  @@map("artwork_assets")
}

enum FavoriteEntityType {
  ARTIST
  ALBUM
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  favorites     Favorite[]
  collections   Collection[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Favorite {
  id         String             @id @default(cuid())
  userId     String
  entityType FavoriteEntityType
  artistId   String?
  albumId    String?
  createdAt  DateTime           @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album  Album?  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@unique([userId, albumId])
  @@index([userId, createdAt])
  @@map("favorites")
}

enum CollectionItemEntityType {
  ARTIST
  ALBUM
}

model Collection {
  id          String           @id @default(cuid())
  userId      String
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, updatedAt])
  @@map("collections")
}

model CollectionItem {
  id           String                   @id @default(cuid())
  collectionId String
  entityType   CollectionItemEntityType
  artistId     String?
  albumId      String?
  position     Int                      @default(0)
  addedAt      DateTime                 @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artist     Artist?    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album      Album?     @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([collectionId, artistId])
  @@unique([collectionId, albumId])
  @@index([collectionId, position, addedAt])
  @@map("collection_items")
}
