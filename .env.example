# Database
# Pooled connection for application queries (use your provider's pooled URL in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soundscape-pooler?schema=public"
# Direct connection for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/soundscape?schema=public"

# Authentication (configure when the auth implementation is selected)
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# MusicBrainz
MUSICBRAINZ_USER_AGENT="SoundScape/1.0.0 (contact: your-email-or-project-url)"
MUSICBRAINZ_DELAY_MS="1100"
MUSICBRAINZ_CACHE_TTL_MS="300000"

# Shared HTTP client defaults
HTTP_MAX_RETRIES="3"
HTTP_TIMEOUT_MS="20000"

# Wikimedia Commons
WIKIMEDIA_USER_AGENT="SoundScape/1.0.0 (contact: your-email-or-project-url)"
